# Copy to .env and fill in what you have. A missing key just disables that provider in the UI.

# System Two (VLMs)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=          # Google AI Studio, billing ENABLED (free tier trains on your uploads)
OPENROUTER_API_KEY=

# System One (TypeSafe Jev; early access at https://console.typesafe.ai)
TYPESAFE_API_KEY=

# Roboflow Universe basketball weights (free key; needs `uv sync --extra roboflow`)
ROBOFLOW_API_KEY=

# Gradio share-link login (required when sharing)
HOOPS_APP_USER=friend
HOOPS_APP_PASSWORD=

# Optional overrides
# HOOPS_DATA_DIR=./data
# HOOPS_FFMPEG=ffmpeg
# HOOPS_RUN_COST_CAP_USD=0.50
# HOOPS_SESSION_COST_CAP_USD=5.00
# PYTORCH_ENABLE_MPS_FALLBACK=1
